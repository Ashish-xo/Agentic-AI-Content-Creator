# LLM brain: b.ai (OpenAI-compatible). Default model qwen3.8-flash.
LLM_BASE_URL=https://api.b.ai/v1
LLM_API_KEY=***
LLM_MODEL=qwen3.8-flash

# Local Postgres (dev). Swap for Supabase DATABASE_URL in prod.
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/content_copilot

ENVIRONMENT=development
PORT=8787

# Optional production wiring — everything degrades gracefully without these.
# CLERK_SECRET_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=
# YOUTUBE_API_KEY=
# APIFY_TOKEN=
# SERPAPI_KEY=
# CORS_ORIGINS=http://localhost:3000
